# chronotope-harness：Python 无状态服务（uv + FastAPI + sse-starlette）
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
COPY harness/pyproject.toml harness/uv.lock* ./
# hatchling 构建 wheel 需要 README（pyproject readme 字段）
COPY harness/README.md ./README.md
RUN uv sync --frozen --no-install-project --no-dev
COPY harness/app ./app
RUN uv sync --frozen --no-dev

FROM python:3.12-slim
WORKDIR /app
ENV PATH="/app/.venv/bin:$PATH"
COPY --from=build /app/.venv .venv
COPY harness/app ./app
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${HARNESS_PORT:-8000}"]
