# === 基础设施 ===
POSTGRES_DB=chronotope
POSTGRES_USER=chronotope
POSTGRES_PASSWORD=chronotope_dev
# 本机直连（compose 内部用 postgres:5432，见 deploy/docker-compose.yml）
DATABASE_URL=postgres://chronotope:chronotope_dev@localhost:5432/chronotope?sslmode=disable

RUSTFS_ROOT_USER=rustfsadmin
RUSTFS_ROOT_PASSWORD=rustfsadmin
RUSTFS_ENDPOINT=localhost:9000

# Restate ingress（compose 内为 restate:8080；宿主机映射 8081）
RESTATE_URL=http://localhost:8081

# === 服务端口 ===
API_ADDR=:8080
WORKER_ADDR=:9080
EXECUTOR_ADDR=:9082
HARNESS_URL=http://localhost:8000
HARNESS_PORT=8000

# === 模型（仅 LiteLLM 容器持有，事件日志零密钥）===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=sk-chronotope-dev

# 模型厂商 Base URL（默认官方端点；可指向任意 OpenAI 兼容端点 / Anthropic 兼容代理，
# 如代理、网关、本地模型服务——多模型切换在 LiteLLM 网关配置化完成）
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
# E2B driver（prod 档沙箱——凭证就绪即跑 test/e2e/e2b-smoke.sh）
EXECUTOR_DRIVER=docker                 # docker | e2b_selfhosted（E2B 官方云走 e2b? 见 executor main 的驱动路由）
E2B_API_URL=                           # 自托管 E2B 网关（空 = 官方 https://api.e2b.dev）
E2B_API_KEY=                           # E2B API 凭证（缺省时 smoke 优雅跳过）
E2B_TEMPLATE_MAP={"*":"base"}   # 镜像名 → E2B 模板映射（官方云仅 base 等官方模板；"*" 兜底）
E2B_TEMPLATE=                          # 沙箱模板 ID（缺省 = 镜像名映射）
